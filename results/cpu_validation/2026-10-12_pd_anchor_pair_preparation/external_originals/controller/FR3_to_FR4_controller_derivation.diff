 FULL_REQUEST_AXIS_GRID_NM = (-.5, -.375, -.25, -.125, 0., .125, .25, .375, .5)
 
 
+def pd_anchor_first_request_candidates(base_request):
+    """Replace one nominal slot per axis; stable index ties and 81 ordered pairs."""
+    request = _pair("base_request", base_request)
+    if any(abs(value) > .5 for value in request):
+        raise ValueError("PD_anchor_requires_current_clipped_public_PD")
+    axes = []
+    for value in request:
+        axis = list(FULL_REQUEST_AXIS_GRID_NM)
+        nearest = min(range(len(axis)), key=lambda index: (abs(axis[index]-value), index))
+        axis[nearest] = value
+        axes.append(tuple(axis))
+    return tuple(product(*axes))
+
+
 def _method_is(instance, name, function):
     return getattr(getattr(instance, name, None), "__func__", None) is function
 
